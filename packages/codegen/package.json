{
  "name": "@apilot/codegen",
  "version": "0.1.0",
  "description": "Language templates for Apilot code generation.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
