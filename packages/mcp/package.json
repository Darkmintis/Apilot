{
  "name": "@apilot/mcp",
  "version": "0.2.0",
  "description": "MCP server for Apilot — lets AI assistants do everything the Apilot panel can: run endpoints, diff responses, version requests, and generate code.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "bin": {
    "apilot-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkmintis/Apilot.git",
    "directory": "packages/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6",
    "vitest": "^2.1"
  },
  "dependencies": {
    "@apilot/codegen": "workspace:*",
    "@apilot/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^0.6"
  }
}
