{
  "name": "@apilot/mcp",
  "version": "0.1.0",
  "description": "MCP server for Apilot — lets AI assistants do everything the Apilot panel can: run endpoints, diff responses, version requests, and generate code.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "bin": {
    "apilot-mcp": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6"
  },
  "dependencies": {
    "@apilot/codegen": "workspace:*",
    "@apilot/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^0.6"
  }
}
