{
  "name": "@apilot/cli",
  "version": "0.1.0",
  "description": "Apilot CLI — run endpoints, generate code, and check API contracts from the command line.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "apilot": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Darkmintis/Apilot.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "start": "node dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6"
  },
  "dependencies": {
    "@apilot/codegen": "workspace:*",
    "@apilot/core": "workspace:*",
    "@apilot/skill": "workspace:*",
    "commander": "^12.1.0"
  }
}
