{
  "name": "@apilot/skill",
  "version": "0.1.0",
  "description": "AI instructions and SKILL.md template for Apilot projects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
