{
  "name": "apilot-workspace",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "pnpm -r build",
    "clean": "pnpm -r clean && pnpm store prune",
    "publish:packages": "pnpm -r --filter '@apilot/*' publish --access public --no-git-checks"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "dependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "yaml": "^2.9.1"
  }
}
